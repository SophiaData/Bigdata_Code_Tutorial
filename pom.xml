    <properties>
        <!-- Java 11 bytecode. Flink 2.x requires Java 11+. -->
        <java.version>11</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        
        <!--
          ============================ Version lines ============================

            default (no profile)   Flink 1.20.0 + Flink CDC 3.6.0-1.20
            -Pflink-2.2            Flink 2.2.0  + Flink CDC 3.6.0-2.2

          Both lines use Flink CDC 3.x, whose Java package is org.apache.flink.cdc.* on either
          Flink major. That is why this project needs no CDC compatibility shim: the only things
          that vary between the lines are dependency coordinates and versions.

          The two lines differ in more than the Flink version:
            - CDC:     3.6.0-1.20            vs 3.6.0-2.2
            - JDBC:    flink-connector-jdbc  vs flink-connector-jdbc-mysql
                       (FLIP-449 split the JDBC connector into per-database artifacts; the
                        aggregate flink-connector-jdbc coordinate stopped at 3.4.0-1.20)
        -->
        <flink.version>1.20.0</flink.version>
        <flink.cdc.version>3.6.0-1.20</flink.cdc.version>
        <!--
          JDBC connector coordinates. Flink 1.20 uses the aggregate artifact; Flink 2.x must use the
          per-database artifact. Both artifactId and version are switched by the profile.
        -->
        <flink.jdbc.artifact>flink-connector-jdbc</flink.jdbc.artifact>
        <flink.jdbc.version>3.4.0-1.20</flink.jdbc.version>
        <!--
          flink-java exists on Flink 1.20 but was removed in Flink 2.x (the DataSet API was dropped
          in 2.0). The 2.2 profile substitutes flink-core, which is already on the classpath, so the
          declaration stays valid without pulling a non-existent artifact.
        -->
        <flink.java.artifact>flink-java</flink.java.artifact>
        <!--
          Flink shades Guava under a version-specific package (guava30 on 1.20, guava33 on 2.2) and
          publishes it as a separate artifact. Only the test scope needs it explicitly.
        -->
        <flink.shaded.guava.version>31.1-jre-17.0</flink.shaded.guava.version>
        <!-- The CDC 3.x connector shades Guava independently; same version on both lines. -->
        <flink.cdc.shaded.guava.version>31.1-jre-17.0</flink.cdc.shaded.guava.version>
        <!-- flink-connector-base tracks the Flink version; it must never be pinned independently. -->
        <flink.connector.base.version>${flink.version}</flink.connector.base.version>
        <!--
          hudi-flink 0.12.1 bundles a Flink 1.15.x runtime. It is unusable on both supported lines
          (1.20 and 2.2), so it is excluded by default; see flink-demo/pom.xml.
        -->
        <flink.demo.hudi.skip>true</flink.demo.hudi.skip>
        
        <!--
          Testcontainers 1.21.x is required for the newer Docker Engine API. 1.20.4 (the previous
          pin) ships a docker-java that cannot parse the response from Docker Engine 29.x (API
          1.55) and fails with "Could not find a valid Docker environment ... Status 400" even
          though the daemon is healthy.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!--
          JUnit 5.8.1 is deliberate: flink-test-utils (Flink 1.17.1) pins junit-platform 1.8.x, and
          forcing a newer junit-jupiter (5.10.x pulls junit-platform 1.10.x) breaks the platform
          contract at runtime with:
            NoSuchMethodError: java.util.Set TestDescriptor.getAncestors()
          Keep this aligned with the Flink version line rather than tracking the newest JUnit.
        -->
        <junit.jupiter.version>5.8.1</junit.jupiter.version>
        <mysql.connector.version>8.4.0</mysql.connector.version>
        <!--
          Surefire tag filtering. Default: skip the Docker-backed tests, include everything else.
          `-Ddocker.tests=true` flips both properties to run only the Docker tests.
        -->
        <test.excluded.groups>docker</test.excluded.groups>
        <test.included.groups />
        <scala.version>2.12</scala.version>
        <hadoop.version>3.1.3</hadoop.version>
        <log4j.version>2.25.3</log4j.version>
        <slf4j.version>1.7.36</slf4j.version>
        <gson.version>2.8.9</gson.version>
        <guava.version>32.1.1-jre</guava.version>
        <json-path.version>2.9.0</json-path.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <commons-dbcp2.version>2.9.0</commons-dbcp2.version>
        <!--
          ===================== Vulnerability overrides =====================
          Versions forced onto transitive dependencies that ship inside the fat jar but resolve to
          releases carrying known CVEs. Each was chosen because OSV reports zero advisories for it:

            snakeyaml 1.32 / "android" 1.23  (via nacos-client and hadoop-common)  -> 2.4
            commons-compress 1.24.0                                                -> 1.27.1
            nimbus-jose-jwt 4.41.1                                                 -> 9.37.4

          snakeyaml is a MAJOR bump (1.x -> 2.x). Neither this project nor its code references
          snakeyaml directly (verified by grep across all sources), and it is used only by
          nacos/hadoop internals for their own configuration parsing, so the 2.x behavioural change
          (safer default constructors) does not affect our code paths.

          Re-evaluate these whenever nacos or hadoop is upgraded: a newer upstream release may make an
          override unnecessary.
        -->
        <snakeyaml.version>2.4</snakeyaml.version>
        <commons-compress.version>1.27.1</commons-compress.version>
        <nimbus-jose-jwt.version>9.37.4</nimbus-jose-jwt.version>
        <!--
          commons-lang3 must be >= 3.13: commons-compress 1.27.1 (raised above) references
          org.apache.commons.lang3.ArrayFill, which does not exist in older releases. Without this
          pin Hadoop's 3.12.0 wins by nearest-wins and the end-to-end test fails with
            NoClassDefFoundError: org/apache/commons/lang3/ArrayFill
          3.18.0 is also the first release with no known advisories, so it clears a CVE too.
        -->
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <!--
          fastjson 1.2.83 was the terminal 1.x release and carries an unfixable autoType
          deserialization history (CVE-2022-25845 and the 1.2.24-1.2.80 series); there is no
          1.x version to bump to, which is why Dependabot never flagged it. fastjson2 is the
          maintained line and is source-compatible for the JSON/JSONObject usage in this repo.
        -->
        <fastjson2.version>2.0.53</fastjson2.version>
        <spotless.version>2.43.0</spotless.version>
        <!--
          Lombok must be >= 1.18.30 to run as an annotation processor on JDK 21+.
          1.18.20 (the previous pin) silently produces no getters/builders on modern JDKs,
          which made the whole project fail to compile.
        -->
        <lombok.version>1.18.48</lombok.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <extra-enforcer-rules.version>1.9.0</extra-enforcer-rules.version>
        <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
        <nacos.version>2.1.2</nacos.version>
        <httpcore.version>4.4.6</httpcore.version>
        <httpclient.version>4.5.13</httpclient.version>
        <maven-shade-plugin>3.5.1</maven-shade-plugin>
        <confluent.version>7.2.0</confluent.version>
        <jackson.version>2.18.11</jackson.version>
        <druid.version>1.2.23</druid.version>
        <joda-time.version>2.10.2</joda-time.version>
        <hudi-flink.version>0.12.1</hudi-flink.version>
        <protobuf-java.version>3.25.5</protobuf-java.version>
        <scala-library.version>2.12.7</scala-library.version>
        <flink-shaded-jackson.version>2.13.4-16.0</flink-shaded-jackson.version>
        <kafka-clients.version>3.4.0</kafka-clients.version>
        <debezium.version>1.9.8.Final</debezium.version>
        <mockito.version>4.6.1</mockito.version>
        <javax.el-api.version>3.0.0</javax.el-api.version>
        <org.glassfish.web.javax.el.version>2.2.4</org.glassfish.web.javax.el.version>
        <org.glassfish.javax.el.version>3.0.1-b11</org.glassfish.javax.el.version>
        <versions-maven-plugin.version>2.14.2</versions-maven-plugin.version>
    </properties>
    
