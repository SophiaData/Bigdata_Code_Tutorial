                    <!--
                      Lombok runs on the annotation processor path. Without this, JDK 23+ no longer
                      implicitly enables annotation processing and Lombok would silently generate
                      nothing (the failure mode that previously broke this build outright).
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <dependencies>
                    <!-- banDuplicateClasses lives in the extra-rules artifact, not the core plugin. -->
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>${extra-enforcer-rules.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <rules>
                                <!--
                                  Fail the build on the dependency problems that actually cause runtime
                                  breakage in a Flink project, rather than on every version skew.

                                  dependencyConvergence is deliberately NOT enabled: this tree has ~27
                                  benign convergence differences coming from Hadoop's internal helpers
                                  (it pulls its own 2.10.0 hadoop-* modules alongside 3.1.3), and
                                  enforcing it would be pure noise.
                                -->
                                <!--
                                  Fail the build on dependency problems that cause real runtime
                                  breakage, instead of on every version skew in the tree.

                                  What is deliberately NOT enabled, and why:

                                  * dependencyConvergence — this tree has ~27 convergence differences
                                    that all come from Hadoop pulling its own 2.10.0 helper modules
                                    alongside 3.1.3. They are benign and enforcing them is pure noise.

                                  * banDuplicateClasses — Flink's own artifacts duplicate classes
                                    between each other by design (flink-cdc-runtime and
                                    flink-table-planner both bundle Calcite; flink-connector-mysql-cdc
                                    vendors Debezium's MySQL classes), and every one of those is
                                    provided scope, so it never reaches this project's shaded jar.
                                    Suppressing them all would mean tracking Flink internals release
                                    by release for no safety gain.

                                  The rules kept below are the ones that fail for a reason a developer
                                  can act on.
                                -->
                                <!-- Dependency cycles make builds and upgrades unpredictable. -->
                                <banCircularDependencies />
                                <!--
                                  Every class on the classpath must be runnable on the Java version this
                                  project targets. Without this, a dependency built for a newer JDK
                                  fails at runtime with UnsupportedClassVersionError instead of here.
                                -->
                                <enforceBytecodeVersion>
                                    <maxJdkVersion>11</maxJdkVersion>
                                    <ignoreClasses>
                                        <!-- Flink itself compiles parts of its runtime for newer JDKs. -->
                                        <ignoreClass>org.apache.flink.*</ignoreClass>
                                        <ignoreClass>org.apache.calcite.*</ignoreClass>
                                    </ignoreClasses>
                                </enforceBytecodeVersion>
                                <!--
                                  Enforce the Java version the code is written for, so a JDK mismatch
                                  fails fast with a clear message instead of an obscure compile error.
                                -->
                                <requireJavaVersion>
                                    <version>[11,)</version>
                                </requireJavaVersion>
                                <!-- Maven itself must be recent enough for the plugins used here. -->
                                <requireMavenVersion>
                                    <version>[3.8.0,)</version>
                                </requireMavenVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!--
                      Tests tagged `docker` (Testcontainers) are excluded from the default run so a
                      plain `mvn verify` works on machines without Docker. Enable them with:

                        mvn verify -Ddocker.tests=true

                      which clears the exclusion and selects the tag instead. Using a property rather
                      than only `-Dgroups=docker` matters because a hard <excludedGroups> would win
                      over -Dgroups and silently skip nothing.
                    -->
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                    <groups>${test.included.groups}</groups>
                    <!--
                      Surefire's default includes are *Test / Test* / *Tests / *TestCase, so a class
                      named *IT is never discovered and would silently run zero tests. Both naming
                      conventions are accepted here; the `docker` tag is what actually gates them.
                    -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <!--
                      Flink's Kryo serializer reflects into JDK internals, which JDK 16+ blocks by
                      default. Without these add-opens flags a job fails at runtime with:
                        InaccessibleObjectException: Unable to make field ... accessible:
                        module java.base does not "opens java.util" to unnamed module
                      These mirror the opens that Flink itself documents for running on JDK 17.
                      (Note: the flag prefix cannot be spelled inside an XML comment, because a
                      double hyphen is illegal there.)
                    -->
                    <argLine>--add-opens=java.base/java.util=ALL-UNNAMED
                        --add-opens=java.base/java.lang=ALL-UNNAMED
                        --add-opens=java.base/java.lang.invoke=ALL-UNNAMED
                        --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens=java.base/java.io=ALL-UNNAMED
                        --add-opens=java.base/java.net=ALL-UNNAMED
                        --add-opens=java.base/java.nio=ALL-UNNAMED
                        --add-opens=java.base/java.time=ALL-UNNAMED
                        --add-opens=java.base/java.text=ALL-UNNAMED
                        --add-opens=java.base/java.math=ALL-UNNAMED
                        --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
                        --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
                        --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED</argLine>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <ratchetFrom>HEAD</ratchetFrom>
                    <java>
                        <!-- google-java-format 1.7 predates JDK 16+; modern versions are required. -->
                        <googleJavaFormat>
                            <version>1.22.0</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports />
                        <importOrder>
                            <order>org.apache.flink,org.apache.flink.shaded,,javax,java,scala,\#</order>
                        </importOrder>
                        <licenseHeader>
                            <file>tool/license.header</file>
                        </licenseHeader>
                    </java>
                    <pom>
                        <includes>
                            <include>pom.xml</include>
                        </includes>
                        <sortPom>
                            <encoding>UTF-8</encoding>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <keepBlankLines>true</keepBlankLines>
                            <indentBlankLines>true</indentBlankLines>
                            <indentSchemaLocation>true</indentSchemaLocation>
                            <spaceBeforeCloseEmptyElement>true</spaceBeforeCloseEmptyElement>
                            <sortModules>false</sortModules>
                            <sortExecutions>false</sortExecutions>
                            <predefinedSortOrder>custom_1</predefinedSortOrder>
                            <expandEmptyElements>false</expandEmptyElements>
                            <sortProperties>false</sortProperties>
                        </sortPom>
                    </pom>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <!-- Binding to `compile` broke builds on unformatted files; verify is the right phase. -->
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    
    <!--
      Repositories are declared but no longer pull snapshots implicitly: the previous
      `snapshot-repos` entry had snapshots enabled, which let unreleased artifacts leak
      into resolution. The Cloudera repo was only needed by the now-removed HBase/Phoenix
      management entries and has been dropped.
    -->
    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>
    
    <profiles>
        <!--
          ============================ Version lines ============================
          Each profile pins a coherent (Flink, Flink CDC, JDBC connector) triple.

            default (no profile)     Flink 1.20.0 + CDC 3.6.0-1.20 + flink-connector-jdbc 3.4.0-1.20
            -Pflink-2.2              Flink 2.2.0  + CDC 3.6.0-2.2  + flink-connector-jdbc-mysql 4.1.0-2.2

          Both lines use Flink CDC 3.x (org.apache.flink.cdc.*), so no CDC shim is needed.
          Only dependency coordinates and versions change between them.
        -->
        
        <profile>
            <id>docker-tests</id>
            <activation>
                <property>
                    <name>docker.tests</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <!-- Clear the exclusion and select only the Docker-backed end-to-end tests. -->
                <test.excluded.groups />
                <test.included.groups>docker</test.included.groups>
            </properties>
        </profile>
        
        <profile>
            <id>flink-1.20</id>
            <properties>
                <flink.version>1.20.0</flink.version>
                <flink.cdc.version>3.6.0-1.20</flink.cdc.version>
                <!-- Flink 1.20 still publishes the aggregate JDBC connector artifact. -->
                <flink.jdbc.artifact>flink-connector-jdbc</flink.jdbc.artifact>
                <flink.jdbc.version>3.4.0-1.20</flink.jdbc.version>
            </properties>
        </profile>
        
        <profile>
            <id>flink-2.2</id>
            <properties>
                <flink.version>2.2.0</flink.version>
                <flink.cdc.version>3.6.0-2.2</flink.cdc.version>
                <!--
                  Flink 2.x only ships the per-database JDBC connector: FLIP-449 split the aggregate
                  artifact, whose last release is 3.4.0-1.20.
                -->
                <flink.jdbc.artifact>flink-connector-jdbc-mysql</flink.jdbc.artifact>
                <flink.jdbc.version>4.1.0-2.2</flink.jdbc.version>
                <!--
                  flink-java was removed in Flink 2.x. Substitute flink-core (already required), so
                  the shared dependency declaration remains resolvable. ParameterTool now lives in
                  flink-core, which is exactly what the compat shim provides.
                -->
                <flink.java.artifact>flink-core</flink.java.artifact>
                <flink.shaded.guava.version>33.4.0-jre-20.0</flink.shaded.guava.version>
                <!-- Required at test runtime; the transitive copy is provided-scoped. -->
            </properties>
        </profile>
        
        <profile>
            <id>google-mirror</id>
            <properties>
                <mavenCentralId>gcs-maven-central-mirror</mavenCentralId>
                <mavenCentralName>GCS Maven Central mirror</mavenCentralName>
                <mavenCentralUrl>https://maven-central.storage-download.googleapis.com/maven2</mavenCentralUrl>
            </properties>
        </profile>
    </profiles>
</project>
